#!/usr/bin/env bash
# moca-listen — /notify/stream を常時購読し、届いた通知を宮舞モカで読み上げる。
#
# ffplay があれば低帯域の Ogg/Opus をストリーミング再生する。なければ WAV を
# ダウンロードし、OS 側のプレイヤー (afplay / SoundPlayer / pw-play 等) で再生する。
# 接続が切れた場合は MOCA_RETRY_DELAY 秒後に自動再接続する。
set -uo pipefail

URL="${MOCA_URL:-http://localhost:3000}"
RETRY_DELAY="${MOCA_RETRY_DELAY:-2}"
PLAYER="${MOCA_PLAYER:-}"
VOLUME="${MOCA_VOLUME:-100}"

# BSD/macOS と GNU/Linux の date で共通の書式。通知生成時刻ではなく観測時刻。
log() {
  printf '[%s] moca-listen: %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*"
}

usage() {
  cat <<'USAGE'
usage: moca-listen [--volume N] [--help]

  --volume N   再生音量 (1〜100、既定 100)。環境変数 MOCA_VOLUME と同じ意味で、引数が優先する
  --help       この説明を表示して終了する

環境変数: MOCA_URL (既定 http://localhost:3000)、MOCA_RETRY_DELAY (既定 2)、
          MOCA_PLAYER (ffplay / afplay / pw-play / paplay / aplay / windows-soundplayer)、MOCA_VOLUME
接続・受信・再生完了は日時付きで標準出力へ、エラーは標準エラーへ表示する。通知本文は表示しない。
音量は ffplay / afplay / pw-play / paplay に渡る。aplay と Windows SoundPlayer は音量指定に対応しないので 100 で再生する。
USAGE
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --volume)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        VOLUME="$2"
        shift 2
        ;;
      --volume=*)
        VOLUME="${1#--volume=}"
        shift
        ;;
      *)
        log "不明な引数です: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done
  # 1〜3 桁の 10 進整数だけを受ける。先頭の 0 は 10 進として読む (bash の 8 進解釈を避ける)。
  if ! [[ "$VOLUME" =~ ^[0-9]{1,3}$ ]] || [ "$((10#$VOLUME))" -lt 1 ] || [ "$((10#$VOLUME))" -gt 100 ]; then
    log "--volume / MOCA_VOLUME は 1〜100 の整数で指定してください: $VOLUME" >&2
    usage >&2
    exit 2
  fi
  VOLUME=$((10#$VOLUME))
}

# 0.00〜1.00 (pw-play / afplay 用)。bash の整数演算だけで小数 2 桁に整形する。
volume_fraction() {
  printf '%d.%02d' $((VOLUME / 100)) $((VOLUME % 100))
}

# 0〜65536 (paplay 用)。
volume_pulse() {
  printf '%d' $((VOLUME * 65536 / 100))
}

player_supports_volume() {
  case "$PLAYER" in
    ffplay|afplay|pw-play|paplay) return 0 ;;
    *) return 1 ;;
  esac
}

is_wsl() {
  case "$(uname -r 2>/dev/null)" in
    *[Mm]icrosoft*|*WSL*) return 0 ;;
    *) return 1 ;;
  esac
}

select_player() {
  if [ -n "$PLAYER" ]; then
    case "$PLAYER" in
      ffplay|afplay|pw-play|paplay|aplay) command -v "$PLAYER" >/dev/null 2>&1 || PLAYER="" ;;
      windows-soundplayer)
        command -v powershell.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1 || PLAYER=""
        ;;
      *) PLAYER="" ;;
    esac
    if [ -z "$PLAYER" ]; then
      log "MOCA_PLAYER で指定されたプレイヤーを利用できません。ffmpeg (ffplay) をインストールするか指定を解除してください。" >&2
      exit 1
    fi
    return
  fi

  if command -v ffplay >/dev/null 2>&1; then
    PLAYER=ffplay
    return
  fi

  case "$(uname -s 2>/dev/null)" in
    Darwin)
      command -v afplay >/dev/null 2>&1 && PLAYER=afplay
      ;;
    Linux)
      if is_wsl && command -v powershell.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
        PLAYER=windows-soundplayer
      elif command -v pw-play >/dev/null 2>&1; then
        PLAYER=pw-play
      elif command -v paplay >/dev/null 2>&1; then
        PLAYER=paplay
      elif command -v aplay >/dev/null 2>&1; then
        PLAYER=aplay
      fi
      ;;
  esac

  if [ -z "$PLAYER" ]; then
    log "音声プレイヤーが見つかりません。ffmpeg (ffplay) をインストールしてください。" >&2
    log "macOS: brew install ffmpeg" >&2
    log "Debian/Ubuntu/WSL: sudo apt install ffmpeg" >&2
    exit 1
  fi
}

# /say の WAV はストリーミング用にサイズが 0xffffffff になっている。
# ファイル再生するネイティブプレイヤー向けに RIFF と data の実サイズを埋め直す。
write_u32_le() {
  local file="$1" offset="$2" value="$3" shift byte
  {
    for shift in 0 8 16 24; do
      byte=$(( (value >> shift) & 255 ))
      printf '%b' "\\$(printf '%03o' "$byte")"
    done
  } | dd of="$file" bs=1 seek="$offset" count=4 conv=notrunc 2>/dev/null
}

finalize_wav() {
  local file="$1" size
  size=$(wc -c < "$file")
  size=${size//[[:space:]]/}
  if [ "$size" -lt 44 ]; then
    log "/say から不正な WAV を受信しました" >&2
    return 1
  fi
  write_u32_le "$file" 4 $((size - 8))
  write_u32_le "$file" 40 $((size - 44))
}

play_native() {
  local text="$1" wav windows_path powershell_path
  wav=$(mktemp "${TMPDIR:-/tmp}/moca-listen.XXXXXX") || return 1
  trap 'rm -f "$wav"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if ! printf '%s' "$text" \
    | curl -fsS -H 'content-type: text/plain' -H 'accept: audio/wav' --data-binary @- -o "$wav" "$URL/say"; then
    log "音声の取得に失敗しました" >&2
    rm -f "$wav"
    trap - EXIT HUP INT TERM
    return 1
  fi
  if ! finalize_wav "$wav"; then
    rm -f "$wav"
    trap - EXIT HUP INT TERM
    return 1
  fi

  case "$PLAYER" in
    afplay) afplay -v "$(volume_fraction)" "$wav" ;;
    pw-play) pw-play --volume "$(volume_fraction)" "$wav" ;;
    paplay) paplay --volume "$(volume_pulse)" "$wav" ;;
    aplay) aplay -q "$wav" ;;
    windows-soundplayer)
      if ! windows_path=$(wslpath -w "$wav"); then
        rm -f "$wav"
        trap - EXIT HUP INT TERM
        return 1
      fi
      powershell_path=${windows_path//\'/\'\'}
      powershell.exe -NoProfile -NonInteractive -Command \
        "\$sound = New-Object System.Media.SoundPlayer '$powershell_path'; \$sound.PlaySync()"
      ;;
  esac
  local status=$?
  rm -f "$wav"
  trap - EXIT HUP INT TERM
  return "$status"
}

play_ffplay() (
  local text="$1" errors status
  errors=$(mktemp "${TMPDIR:-/tmp}/moca-listen.XXXXXX") || return 1
  trap 'rm -f "$errors"' EXIT
  trap 'exit 129' HUP
  # INT は既定のままにし、再生中の Ctrl-C を親の listener まで伝える。
  trap 'exit 143' TERM

  printf '%s' "$text" \
    | curl -fsS -H 'content-type: text/plain' -H 'accept: audio/ogg' --data-binary @- "$URL/say" \
    | ffplay -hide_banner -loglevel error -nostats -nodisp -autoexit -volume "$VOLUME" - 2> "$errors"
  status=$?
  # ffplay はデコード・音声デバイスのエラーでも exit 0 になることがある。
  # error level の診断を保持し、成功表示にしてしまわない。
  if [ -s "$errors" ]; then
    cat "$errors" >&2
    status=1
  fi
  return "$status"
)

play_notification() {
  local text="$1"
  if [ "$PLAYER" = ffplay ]; then
    play_ffplay "$text"
  else
    play_native "$text"
  fi
}

consume_stream() (
  local connected_message="${1:-接続しました}" line data="" value
  local headers=true status="" content_type=""
  # HTTP header 名・media type は大文字小文字を区別しない。設定はこの subshell 内だけ。
  shopt -s nocasematch
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    if [ "$headers" = true ]; then
      case "$line" in
        HTTP/*)
          status=${line#* }
          status=${status%% *}
          content_type=""
          ;;
        Content-Type:*)
          content_type=${line#*:}
          content_type=${content_type#"${content_type%%[![:space:]]*}"}
          content_type=${content_type%"${content_type##*[![:space:]]}"}
          ;;
        '')
          case "$status" in
            1??) continue ;; # interim response の次に最終応答を待つ
            200)
              case "$content_type" in
                text/event-stream|text/event-stream\;*)
                  log "$connected_message"
                  headers=false
                  shopt -u nocasematch
                  ;;
                *) log "SSE の応答ではありません" >&2; return 1 ;;
              esac
              ;;
            *) log "SSE 接続に失敗しました (HTTP $status)" >&2; return 1 ;;
          esac
          ;;
      esac
      continue
    fi
    case "$line" in
      data:*)
        value=${line#data:}
        value=${value# }
        if [ -n "$data" ]; then
          data+=$'\n'
        fi
        data+="$value"
        ;;
      '')
        if [ -n "$data" ]; then
          log "通知を受信しました"
          if play_notification "$data"; then
            log "通知を再生しました"
          else
            log "通知の再生に失敗しました" >&2
          fi
          data=""
        fi
        ;;
    esac
  done
  [ "$headers" = false ]
)

listen_once() {
  # -D - は header を即時 flush する (-i は body 到着まで表示が遅れる場合がある)。
  # 通知なしでも最終 HTTP 応答で接続成立を観測する。
  # HTTPS proxy の CONNECT 応答は SSE server の応答と混同しない。
  curl -fsSN -D - --suppress-connect-headers -H 'accept: text/event-stream' "$URL/notify/stream" \
    | consume_stream "$1"
}

main() {
  parse_args "$@"
  select_player
  local connected_message="接続しました"
  log "$URL に接続します ($PLAYER, 音量 $VOLUME)"
  if [ "$VOLUME" -lt 100 ] && ! player_supports_volume; then
    log "$PLAYER は音量指定に対応しないため 100 で再生します" >&2
  fi

  while true; do
    if listen_once "$connected_message"; then
      log "接続が終了しました。${RETRY_DELAY}秒後に再接続します"
    else
      log "接続できません。${RETRY_DELAY}秒後に再接続します" >&2
    fi
    connected_message="再接続しました"
    sleep "$RETRY_DELAY"
  done
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
  main "$@"
fi
